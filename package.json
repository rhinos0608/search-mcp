{
  "name": "search-mcp",
  "version": "7.0.0",
  "description": "MCP server with 18 tools for web search, semantic RAG, code analysis, knowledge graph, job search, academic research, social media, browser automation, and health",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "search-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:json": "tsx watch src/index.ts -- --json",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "start:json": "node dist/index.js --json",
    "test": "node scripts/run-tests.cjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src docs",
    "format:check": "prettier --check src docs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "config:encrypt": "tsx scripts/encrypt-config.ts",
    "config:decrypt": "tsx scripts/decrypt-config.ts",
    "build:dashboard": "cd dashboard && npm run build",
    "build:all": "npm run build && npm run build:dashboard",
    "install:dashboard": "cd dashboard && npm install",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^11.10.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.0",
    "jobspy-js": "^1.7.0",
    "jsdom": "^29.0.1",
    "officeparser": "^7.5.1",
    "onnxruntime-node": "^1.24.3",
    "pdf-parse": "^2.4.5",
    "pino": "^9.0.0",
    "rss-parser": "^3.13.0",
    "safe-regex2": "^5.1.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8",
    "youtube-transcript": "^1.3.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "cloakbrowser": "^0.3.27",
    "playwright-core": "^1.53.0",
    "rebrowser-playwright": "^1.52.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.1",
    "@types/mozilla__readability": "^0.4.2",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.25.0"
  },
  "engines": {
    "node": ">=20.16.0"
  }
}
