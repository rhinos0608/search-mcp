# HTTP server (leave unset to run stdio-only)
HTTP_PORT=8050

# Encryption key for config.enc — REQUIRED when HTTP_PORT is set
SEARCH_MCP_CONFIG_KEY=your-strong-passphrase-here

# Dashboard session lifetime (default: 12h)
SESSION_TTL_HOURS=12

# Enable query-param API key auth (not recommended; may leak in logs)
MCP_ALLOW_QUERY_KEY=false

# ── Codex (ChatGPT) web search — limited support ───────────────────────────
# Main web_search source. Every configured available backend also runs; matching
# URLs dedupe against Codex. Reads credentials from CODEX_ACCESS_TOKEN or
# tokens.access_token in ${CODEX_HOME:-~/.codex}/auth.json. Uses a fixed
# https://chatgpt.com/backend-api/codex/alpha/search endpoint (no override);
# undocumented, may be rate-limited or unavailable.
# CODEX_ACCESS_TOKEN=
# CODEX_ACCOUNT_ID=
# CODEX_HOME=

# ── Document & multimodal parsing (on by default) ───────────────────────────
# In-process PDF/office parsing is ON by default and auto-discovers pdf-parse /
# officeparser, degrading gracefully (a warning) if either is absent. Set
# DOCUMENT_PARSING_ENABLED=false to disable. Multimodal VLM figure/table
# enrichment remains opt-in (default false).
DOCUMENT_PARSING_ENABLED=true
DOCUMENT_PARSING_MULTIMODAL=false
DOCUMENT_PARSING_MAX_ENRICH=3
